---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostArticle from '../../components/blog/PostArticle.astro';
import PostRelated from '../../components/blog/PostRelated.astro';
import { posts, type Post } from '../../data/blog';
export function getStaticPaths() { return posts.map((post) => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props as { post: Post };
---
<Base title={`${post.title} — Lorem Ipsum`}>
  <Header />
  <main>
    <div aria-hidden="true" style="height:112px"></div>
    <PostArticle post={post} /><PostRelated post={post} />
  </main>
  <Footer />
</Base>
