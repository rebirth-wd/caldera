---
// "Other posts" block under a post: heading + two index cards (the next two posts in the list).
import BlogCard from './BlogCard.astro';
import { posts, postUi, type Post } from '../../data/blog';
interface Props { post: Post }
const { post } = Astro.props;
const i = posts.findIndex((p) => p.slug === post.slug);
const related = [1, 2].map((d) => posts[(i + d) % posts.length]);
---
<section class="pr" data-qa="post-related" aria-labelledby="pr-heading">
  <div class="container-x">
    <h2 id="pr-heading" class="display pr__h2" data-reveal="chars">{postUi.related}</h2>
    <ul class="pr__grid">{related.map((p) => <BlogCard post={p} />)}</ul>
  </div>
</section>
<style>
  .pr { padding: 40px 0 120px; }
  .pr__h2 { font-size: 80px; line-height: 88px; text-align: center; margin-bottom: var(--spacing-64); }
  .pr__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--spacing-16); margin: 0; padding: 0; list-style: none; }
  @media (max-width: 760px) { .pr__grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) {
    .pr { padding: 0 0 64px; }
    .pr > div { padding-inline: 20px; }
    .pr__h2 { font-size: 52px; line-height: 56px; margin-bottom: var(--spacing-40); }
  }
</style>
