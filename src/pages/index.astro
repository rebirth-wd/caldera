---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ecosystem from '../components/Ecosystem.astro';
import Products from '../components/Products.astro';
import UseCases from '../components/UseCases.astro';
import News from '../components/News.astro';
import Community from '../components/Community.astro';
import Sections from '../components/Sections.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main>
    <div aria-hidden="true" style="height:112px"></div>
    <Hero /><Ecosystem /><Products /><UseCases /><News /><Community /><Sections />
  </main>
  <Footer />
</Base>
