---
// Index card: same anatomy as the home News card (image, Sulfur tag, display title, date) at the blog grid's measurements.
import BlogMedia from './BlogMedia.astro';
import { catLabel, type Post } from '../../data/blog';
import { site } from '../../data/copy';
interface Props { post: Post; refs?: Record<string, string>; hidden?: boolean }
const { post, refs, hidden = false } = Astro.props;
---
<li class="bc" data-bl-card data-cat={post.cat} hidden={hidden}>
  <a class="bc__link" href="#" data-qa={refs ? 'blog-card-first' : undefined} data-ref={refs?.card}>
    <span class="bc__img" data-qa={refs ? 'blog-card-image' : undefined} data-ref={refs?.img}><BlogMedia image={post.image} tone={post.tone} /></span>
    <span class="bc__info">
      <span class="bc__tag" data-qa={refs ? 'blog-card-tag' : undefined} data-ref={refs?.tag}>{catLabel[post.cat]}</span>
      <span class="display bc__title" role="heading" aria-level="3" data-qa={refs ? 'blog-card-title' : undefined} data-ref={refs?.title}>{post.title}</span>
      <span class="bc__date" data-qa={refs ? 'blog-card-date' : undefined} data-ref={refs?.date}><time>{post.date}</time></span>
    </span>
  </a>
</li>
<style>
  .bc { min-width: 0; }
  .bc[hidden] { display: none; }
  .bc__link { box-sizing: border-box; display: block; padding: var(--spacing-16); border-radius: var(--radius-3xl-3); background: var(--color-limestone); color: var(--color-obsidian); }
  .bc__link:focus-visible { outline: 2px solid var(--color-obsidian); outline-offset: 2px; }
  .bc__img { position: relative; display: block; aspect-ratio: 624 / 350.9; border-radius: var(--radius-2xl-2); overflow: hidden; }
  .bc__link:hover :global(.bm__photo) { transform: scale(1.04); }
  .bc__info { display: flex; flex-direction: column; align-items: flex-start; padding: var(--spacing-32) var(--spacing-16) var(--spacing-16); }
  .bc__tag { padding: 3px var(--spacing-8); border-radius: var(--radius-3xl); background: var(--color-sulfur); font-size: 14px; line-height: 16.8px; }
  .bc__title { margin-top: var(--spacing-16); width: 100%; height: 77px; font-size: 32px; line-height: 38.4px; letter-spacing: .64px;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
  .bc__date { display: block; width: 100%; margin-top: var(--spacing-16); font-size: 16px; line-height: 24.8px; }
  @media (max-width: 640px) {
    .bc__link { border-radius: var(--radius-3xl-2); padding: var(--spacing-12); }
    .bc__info { padding: var(--spacing-24) var(--spacing-8) var(--spacing-8); }
    .bc__title { font-size: 26px; line-height: 31.2px; height: auto; min-height: 31.2px; }
  }
</style>
