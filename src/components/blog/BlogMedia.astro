---
// Duotone + halftone photo block (same treatment as Products.astro). Solid tone block when the photo is missing or fails.
import { images } from '../../data/images';
interface Props { image: string; tone?: 'ember' | 'violet'; eager?: boolean; w?: number; h?: number }
const { image, tone = 'ember', eager = false, w = 1248, h = 702 } = Astro.props;
const img = images[image];
const toneVar = tone === 'violet' ? 'var(--color-plasma-violet)' : 'var(--color-ember)';
---
<span class="bm" style={`--tone:${toneVar}`}>
  {img?.url && (
    <img class="bm__photo" src={img.url} alt={img.alt} width={w} height={h} loading={eager ? 'eager' : 'lazy'} decoding="async"
      data-credit={img.credit || undefined} onerror="this.style.display='none'" />
  )}
  <span class="bm__wash"></span>
  <span class="bm__halftone" aria-hidden="true"></span>
</span>
<style>
  .bm { position: absolute; inset: 0; display: block; background: var(--tone); overflow: hidden; isolation: isolate; }
  .bm__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.2) brightness(1.15); mix-blend-mode: multiply; opacity: .62; transition: transform .6s cubic-bezier(.22, 1, .36, 1); }
  .bm__wash { position: absolute; inset: 0; background: var(--tone); mix-blend-mode: screen; opacity: .28; }
  .bm__halftone { position: absolute; inset: 0; opacity: .5;
    background-image: radial-gradient(circle, var(--color-obsidian) 0 34%, transparent 38%); background-size: 8px 8px;
    -webkit-mask-image: radial-gradient(ellipse 55% 60% at 100% 0%, #000 0, transparent 100%), radial-gradient(ellipse 60% 55% at 0% 100%, rgba(0,0,0,.55) 0, transparent 100%);
    mask-image: radial-gradient(ellipse 55% 60% at 100% 0%, #000 0, transparent 100%), radial-gradient(ellipse 60% 55% at 0% 100%, rgba(0,0,0,.55) 0, transparent 100%); }
</style>
