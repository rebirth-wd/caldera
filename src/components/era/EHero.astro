---
// Hero: full-viewport block (16px inset) holding an Ember card (radius 32) with a looping halftone texture and three
// centred display lines 120 / 300 / 120px. data-ref values are for the 1440×723 QA viewport, derived from the 779 capture with the measured 10vh / 90vh model
// (reference/era/REFERENCE.md).
import { era } from '../../data/era.ts';
const { top, big, bottom } = era.hero;
---
<section class="ehero" data-ehero data-qa="era-hero" data-ref="0,0,1440,723">
  <div class="ehero__card" data-qa="era-hero-card" data-ref="16,16,1408,691">
    <canvas class="ehero__canvas" data-ehero-canvas aria-hidden="true"></canvas>
  </div>
  <h1 class="ehero__stack" aria-label={`${top} ${big} ${bottom}`}>
    <span class="display ehero__sm" data-ehero-line data-qa="era-hero-line-1" data-ref="548,136,345,113" aria-hidden="true">{top}</span>
    <span class="display ehero__lg" data-ehero-line data-qa="era-hero-line-2" data-ref="375,257,691,282" aria-hidden="true">{big}</span>
    <span class="display ehero__sm" data-ehero-line data-qa="era-hero-line-3" data-ref="520,547,400,113" aria-hidden="true">{bottom}</span>
  </h1>
</section>

<style>
  .ehero { position: relative; box-sizing: border-box; height: 100vh; min-height: 640px; padding: var(--spacing-16); }
  .ehero__card { position: relative; height: 100%; border-radius: var(--radius-3xl-2); overflow: hidden; background: var(--color-ember); }
  .ehero__canvas { width: 100%; height: 100%; opacity: .5; }
  /* reference: header-space 10vh, then a 90vh column, centred, gap 8 */
  .ehero__stack { position: absolute; inset: 10% 0 0 0; margin: 0; padding-inline: var(--spacing-56); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--spacing-8); }
  .ehero__sm, .ehero__lg { display: block; white-space: nowrap; text-align: center; }
  .ehero__sm { font-size: 120px; line-height: 112.8px; color: var(--color-obsidian); }
  .ehero__lg { font-size: 300px; line-height: 282px; color: var(--color-pumice); }

  @media (max-width: 1023px) {
    .ehero { height: 100svh; min-height: 520px; padding: var(--spacing-8); }
    .ehero__card { border-radius: var(--radius-3xl); }
    .ehero__stack { padding-inline: var(--spacing-16); gap: 0; }
    .ehero__sm { font-size: clamp(40px, 12vw, 120px); line-height: .94; }
    .ehero__lg { font-size: clamp(96px, 30vw, 300px); line-height: .94; }
  }
</style>

<script>
  import { gsap, EASE, reduced } from '../../scripts/motion.ts';

  const root = document.querySelector<HTMLElement>('[data-ehero]');
  if (root) {
    // Appear (Framer data: opacity 0.001 -> 1, spring bounce 0.2, 0.4s), staggered per line.
    const lines = [...root.querySelectorAll<HTMLElement>('[data-ehero-line]')];
    if (!reduced) gsap.from(lines, { opacity: 0, y: 24, duration: 0.6, ease: EASE, stagger: 0.12, delay: 0.15 });

    // Looping halftone: Obsidian dots on the Ember card (canvas at 50% opacity => dark orange), dot size driven by
    // broad horizontal bands that drift; every time term is an integer multiple of the loop phase => seamless.
    const canvas = root.querySelector<HTMLCanvasElement>('[data-ehero-canvas]')!;
    const card = canvas.parentElement!;
    const ctx = canvas.getContext('2d')!;
    const OBS = getComputedStyle(document.documentElement).getPropertyValue('--color-obsidian').trim();
    const PITCH = 11, LOOP = 26, TAU = Math.PI * 2;
    let w = 0, h = 0, dpr = 1, cols = 0, rows = 0;
    const state = { phase: 0 };

    function draw(phase: number) {
      if (!w) return;
      const a = phase * TAU, s1 = Math.sin(a), c1 = Math.cos(a);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = OBS; ctx.globalAlpha = 0.5; ctx.beginPath();
      for (let j = 0; j < rows; j++) {
        const v = (j * PITCH) / 747, y = j * PITCH;
        for (let i = 0; i < cols; i++) {
          const u = (i * PITCH) / 747;
          let f = Math.sin(v * 7.2 + 0.9 * Math.sin(u * 2.1 + a) + 0.6 * s1)
                + 0.7 * Math.sin(u * 3.1 - v * 4.3 + a + 1.4 * c1)
                + 0.5 * Math.sin(u * 5.7 + v * 2.2 - 2 * a + 2.0)
                + 0.9 * (v - 0.5);                          // denser towards the bottom, as in the reference
          f = f / 2.6 * 1.25 + 0.42; f = f < 0 ? 0 : f > 1 ? 1 : f;
          const r = PITCH * (0.06 + 0.42 * f), x = i * PITCH;
          ctx.moveTo(x + r, y); ctx.arc(x, y, r, 0, TAU);
        }
      }
      ctx.fill(); ctx.globalAlpha = 1;
    }
    function resize() {
      const r = card.getBoundingClientRect();
      w = Math.max(1, Math.round(r.width)); h = Math.max(1, Math.round(r.height));
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      cols = Math.ceil(w / PITCH) + 1; rows = Math.ceil(h / PITCH) + 1;
      draw(state.phase);
    }
    let frame = 0, onScreen = false;
    const loop = gsap.to(state, { phase: 1, duration: LOOP, ease: 'none', repeat: -1, paused: true, onUpdate: () => { if ((frame++ & 1) === 0) draw(state.phase); } });
    const sync = () => { if (onScreen && !document.hidden && !reduced) loop.play(); else loop.pause(); };
    new ResizeObserver(resize).observe(card);
    new IntersectionObserver((e) => { onScreen = e[0].isIntersecting; sync(); }, { threshold: 0 }).observe(card);
    document.addEventListener('visibilitychange', sync);
    resize();
  }
</script>
