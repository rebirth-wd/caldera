---
// Looping infographic, row 2: an edge network. A central origin node feeds six edge nodes; packets travel the links.
import ProdGlyph from './ProdGlyph.astro';
const C = { x: 384, y: 294 };
const nodes = [0, 1, 2, 3, 4, 5].map((k) => { const a = (k * 60 * Math.PI) / 180; return { x: Math.round(C.x + 272 * Math.cos(a)), y: Math.round(C.y + 204 * Math.sin(a)) }; });
const links: { a: { x: number; y: number }; b: { x: number; y: number }; kind: string }[] = [];
nodes.forEach((n, k) => {
  links.push({ a: C, b: n, kind: 'spoke' });
  links.push({ a: n, b: nodes[(k + 1) % 6], kind: 'ring' });
  links.push({ a: n, b: { x: Math.round(n.x + (n.x - C.x) * 0.9), y: Math.round(n.y + (n.y - C.y) * 0.9) }, kind: 'out' });
});
const star = 'M0-22C3-7 7-3 22 0 7 3 3 7 0 22-3 7-7 3-22 0-7-3-3-7 0-22Z';
---
<svg class="pge" viewBox="0 0 768 589" preserveAspectRatio="xMidYMid slice" aria-hidden="true" data-prod-graphic="edge">
  {links.map((l) => (
    <g stroke-linecap="round" fill="none">
      <line x1={l.a.x} y1={l.a.y} x2={l.b.x} y2={l.b.y} stroke="var(--color-obsidian)" stroke-width="14" />
      <line x1={l.a.x} y1={l.a.y} x2={l.b.x} y2={l.b.y} stroke="var(--color-chalk)" stroke-width="3.5" stroke-dasharray="0.1 13.9" data-flow="14" />
    </g>
  ))}
  {links.map((l) => (
    <rect x="-8" y="-8" width="16" height="16" rx="4" fill="var(--color-chalk)" stroke="var(--color-obsidian)" stroke-width="4"
      data-packet={l.kind} data-from={`${l.a.x},${l.a.y}`} data-to={`${l.b.x},${l.b.y}`} transform={`translate(${l.a.x} ${l.a.y})`} />
  ))}
  {nodes.map((n) => (
    <g transform={`translate(${n.x} ${n.y})`}>
      <rect x="-46" y="-46" width="92" height="92" rx="24" fill="var(--color-obsidian)" />
      <rect x="-35" y="-35" width="70" height="70" rx="14" fill="none" stroke="var(--color-chalk)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="0.1 8" opacity="0.7" />
      <path d={star} fill="var(--color-chalk)" data-star />
    </g>
  ))}
  <g transform={`translate(${C.x} ${C.y})`}>
    <circle r="92" fill="none" stroke="var(--color-chalk)" stroke-width="3" opacity="0" data-ring />
    <g data-core>
      <circle r="88" fill="var(--color-obsidian)" />
      <circle r="72" fill="none" stroke="var(--color-chalk)" stroke-width="3" stroke-linecap="round" stroke-dasharray="0.1 11.21" data-flow="11.31" />
      <ProdGlyph kind="burst" pitch={11} r={3.6} />
    </g>
  </g>
</svg>
<style>
  .pge { position: absolute; inset: 0; width: 100%; height: 100%; }
</style>
<script>
  import { gsap, ScrollTrigger, reduced } from '../scripts/motion.ts';
  document.querySelectorAll<SVGSVGElement>('[data-prod-graphic="edge"]').forEach((svg) => {
    if (reduced) return;
    const q = <T extends Element>(s: string) => [...svg.querySelectorAll<T>(s)];
    const T = 4.8;
    const stars = q<SVGPathElement>('[data-star]'), core = svg.querySelector('[data-core]')!, ring = svg.querySelector('[data-ring]')!;
    gsap.set([core, ring, ...stars], { transformOrigin: '50% 50%' });
    const tl = gsap.timeline({ repeat: -1, paused: true });
    q<SVGElement>('[data-flow]').forEach((el) => {
      const period = Number(el.dataset.flow);
      tl.fromTo(el, { strokeDashoffset: 0 }, { strokeDashoffset: -period * 6, duration: T, ease: 'none' }, 0);
    });
    // packets start and end hidden beneath the obsidian nodes, so the loop point is invisible
    const move = (el: SVGElement, at: number, dur: number) => {
      const [fx, fy] = (el.dataset.from || '').split(',').map(Number), [tx, ty] = (el.dataset.to || '').split(',').map(Number);
      tl.fromTo(el, { x: fx, y: fy }, { x: tx, y: ty, duration: dur, ease: 'power1.inOut', immediateRender: false }, at);
    };
    const bump = (el: Element, at: number, s = 1.3) => tl.to(el, { scale: s, duration: 0.18, repeat: 1, yoyo: true, ease: 'power2.out' }, at);
    tl.to(core, { scale: 1.06, duration: 0.2, repeat: 1, yoyo: true, ease: 'power2.out' }, 0.05)
      .fromTo(ring, { scale: 1, opacity: 0.9 }, { scale: 1.7, opacity: 0, duration: 0.9, ease: 'power2.out' }, 0.1);
    q<SVGRectElement>('[data-packet="spoke"]').forEach((p, k) => { move(p, 0.2 + k * 0.12, 1.1); bump(stars[k], 1.2 + k * 0.12); });
    q<SVGRectElement>('[data-packet="ring"]').forEach((p, k) => { move(p, 1.6 + k * 0.12, 1.0); bump(stars[(k + 1) % 6], 2.5 + k * 0.12, 1.2); });
    q<SVGRectElement>('[data-packet="out"]').forEach((p, k) => move(p, 2.9 + k * 0.12, 1.2));
    tl.to({}, { duration: 0.01 }, T - 0.01);
    ScrollTrigger.create({ trigger: svg, start: 'top bottom', end: 'bottom top', onToggle: (s) => (s.isActive ? tl.play() : tl.pause()) });
  });
</script>
