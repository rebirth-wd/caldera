---
// Looping infographic, row 1: an assistant (chat bubble, typing) sends pulses to four service nodes and gets answers back.
// Line art only: obsidian solids, chalk dotted strokes. One repeating GSAP timeline, paused while off-screen.
const H = { x: 384, y: 298 };
const dash = (r: number, approx: number) => { const c = 2 * Math.PI * r; return +(c / Math.round(c / approx)).toFixed(3); };
const d1 = dash(176, 12), d2 = dash(262, 12);
const nodes = [
  { x: 128, y: 116, icon: '<circle cx="0" cy="0" r="17"/><path d="M0-9V1l7 5"/>' },
  { x: 640, y: 116, icon: '<path d="M-17-17h15L17 2 2 17-17-2z"/><circle cx="-8" cy="-8" r="2.5"/>' },
  { x: 128, y: 474, icon: '<path d="M0 19s14-12 14-23a14 14 0 1 0-28 0C-14 7 0 19 0 19z"/><circle cx="0" cy="-4" r="4"/>' },
  { x: 640, y: 474, icon: '<path d="M-8-8a8 8 0 1 1 12 7c-3 1.5-4 3-4 6"/><path d="M0 16v.5"/>' },
];
---
<svg class="pga" viewBox="0 0 768 589" preserveAspectRatio="xMidYMid slice" aria-hidden="true" data-prod-graphic="assistant">
  <g fill="none" stroke="var(--color-obsidian)" stroke-linecap="round">
    <circle cx={H.x} cy={H.y} r="176" stroke-width="3" stroke-dasharray={`0.1 ${d1 - 0.1}`} data-flow={d1} />
    <circle cx={H.x} cy={H.y} r="262" stroke-width="3" stroke-dasharray={`0.1 ${d2 - 0.1}`} opacity="0.6" data-flow={-d2} />
  </g>
  {nodes.map((n) => (
    <g stroke-linecap="round" fill="none">
      <line x1={H.x} y1={H.y} x2={n.x} y2={n.y} stroke="var(--color-obsidian)" stroke-width="14" />
      <line x1={H.x} y1={H.y} x2={n.x} y2={n.y} stroke="var(--color-chalk)" stroke-width="3.5" stroke-dasharray="0.1 13.9" data-flow="14" />
    </g>
  ))}
  {nodes.map((n) => (
    <circle r="9" fill="var(--color-chalk)" stroke="var(--color-obsidian)" stroke-width="5" data-pulse data-to={`${n.x},${n.y}`} transform={`translate(${H.x} ${H.y})`} />
  ))}
  {nodes.map((n) => (
    <g transform={`translate(${n.x} ${n.y})`}>
      <circle r="58" fill="none" stroke="var(--color-chalk)" stroke-width="3" opacity="0" data-ring />
      <g data-node>
        <rect x="-54" y="-54" width="108" height="108" rx="26" fill="var(--color-obsidian)" />
        <rect x="-42" y="-42" width="84" height="84" rx="16" fill="none" stroke="var(--color-chalk)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="0.1 8" opacity="0.7" />
        <g fill="none" stroke="var(--color-chalk)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" set:html={n.icon} />
      </g>
    </g>
  ))}
  <g transform={`translate(${H.x} ${H.y})`}>
    <g data-hub>
      <path d="M-78 60 L-104 112 L-30 78 Z" fill="var(--color-obsidian)" />
      <rect x="-124" y="-84" width="248" height="168" rx="40" fill="var(--color-obsidian)" />
      <rect x="-108" y="-68" width="216" height="136" rx="26" fill="none" stroke="var(--color-chalk)" stroke-width="3" stroke-linecap="round" stroke-dasharray="0.1 10" data-flow="10" />
      {[-44, 0, 44].map((x) => <circle cx={x} cy="0" r="11" fill="var(--color-chalk)" data-typing />)}
    </g>
  </g>
</svg>
<style>
  .pga { position: absolute; inset: 0; width: 100%; height: 100%; }
</style>
<script>
  import { gsap, ScrollTrigger, reduced } from '../scripts/motion.ts';
  document.querySelectorAll<SVGSVGElement>('[data-prod-graphic="assistant"]').forEach((svg) => {
    if (reduced) return;
    const q = <T extends Element>(s: string) => [...svg.querySelectorAll<T>(s)];
    const H = { x: 384, y: 298 }, T = 5.6;
    const pulses = q<SVGCircleElement>('[data-pulse]'), nodes = q<SVGGElement>('[data-node]'), rings = q<SVGCircleElement>('[data-ring]');
    const hub = svg.querySelector('[data-hub]')!, typing = q<SVGCircleElement>('[data-typing]');
    gsap.set([hub, ...nodes, ...rings], { transformOrigin: '50% 50%' });
    const tl = gsap.timeline({ repeat: -1, paused: true, defaults: { ease: 'power2.inOut' } });
    // dotted strokes drift by a whole number of dash periods over one loop => seamless
    q<SVGElement>('[data-flow]').forEach((el) => {
      const period = Number(el.dataset.flow);
      tl.fromTo(el, { strokeDashoffset: 0 }, { strokeDashoffset: -period * 6, duration: T, ease: 'none' }, 0);
    });
    // 1) assistant is "typing"
    typing.forEach((d, i) => tl.to(d, { y: -14, duration: 0.22, repeat: 3, yoyo: true, ease: 'sine.inOut' }, 0.1 + i * 0.14));
    tl.to(hub, { scale: 1.05, duration: 0.18, repeat: 1, yoyo: true }, 1.25);
    // 2) pulses travel hub -> service nodes, each node acknowledges
    pulses.forEach((p, i) => {
      const [x, y] = (p.dataset.to || '').split(',').map(Number), at = 1.4 + i * 0.14;
      tl.fromTo(p, { x: H.x, y: H.y }, { x, y, duration: 1.0, immediateRender: false }, at)
        .to(nodes[i], { scale: 1.12, duration: 0.2, repeat: 1, yoyo: true }, at + 0.85)
        .fromTo(rings[i], { scale: 1, opacity: 0.9 }, { scale: 1.6, opacity: 0, duration: 0.7, ease: 'power2.out', immediateRender: false }, at + 0.9)
        // 3) answers travel back to the assistant
        .to(p, { x: H.x, y: H.y, duration: 1.0 }, at + 1.7);
    });
    tl.to(hub, { scale: 1.07, duration: 0.2, repeat: 1, yoyo: true }, 4.3)
      .to(typing, { scale: 1.25, transformOrigin: '50% 50%', duration: 0.2, repeat: 1, yoyo: true, stagger: 0.08 }, 4.45)
      .to({}, { duration: 0.01 }, T - 0.01);
    ScrollTrigger.create({ trigger: svg, start: 'top bottom', end: 'bottom top', onToggle: (s) => (s.isActive ? tl.play() : tl.pause()) });
  });
</script>
