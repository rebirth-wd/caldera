---
// Rollups hero: media block (582x544) + Limestone info card (730x544). Rects from reference/rollups/REFERENCE.md "Hero".
import { rHero, rImages } from '../../data/rollups.ts';
import RMedia from './RMedia.astro';
---
<section class="rh" data-qa="r-hero" data-ref="0,112,1440,544">
  <div class="rh__row">
    <div class="rh__media"><RMedia kind="machine" img={rImages.hero} qa="r-hero-media" ref="56,112,582,544" /></div>
    <div class="rh__card" data-qa="r-hero-card" data-ref="654,112,730,544">
      <div class="rh__top" data-rh-in>
        <span class="rh__tag" data-qa="r-hero-tag" data-ref="702,160,82,34">{rHero.tag}</span>
        <h1 class="display rh__h1" data-rh-h1 data-qa="r-hero-h1" data-ref="702,226,480,132">
          {rHero.lines.map((l) => <span class="rh__line">{l} </span>)}
        </h1>
      </div>
      <div class="rh__bottom" data-rh-in>
        <p class="rh__p" data-qa="r-hero-p" data-ref="702,471,406,50">{rHero.sub}</p>
        <div class="rh__btns">
          <a class="btn btn-lg rh__btn rh__btn--dark" href={rHero.primary.href} data-qa="r-hero-btn-1" data-ref="702,552,196,56">{rHero.primary.label}</a>
          <a class="btn btn-dotted btn-lg rh__btn rh__btn--dotted" href={rHero.secondary.href} data-qa="r-hero-btn-2" data-ref="908,552,259,56">{rHero.secondary.label}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rh { width: 100%; max-width: 1440px; margin-inline: auto; padding-inline: var(--spacing-56); }
  .rh__row { display: flex; gap: var(--spacing-16); height: 544.1px; }
  .rh__media { flex: 0 0 calc((100% - 16px) * 581.6 / 1312); min-width: 0; display: flex; }
  .rh__media > :global(.rmedia) { flex: 1; }
  .rh__card { flex: 1 1 0; min-width: 0; box-sizing: border-box; padding: var(--spacing-48); border-radius: var(--radius-cards); background: var(--color-limestone); display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; }
  .rh__top { display: flex; flex-direction: column; align-items: flex-start; gap: var(--spacing-32); }
  .rh__top, .rh__bottom { max-width: 100%; }
  .rh__tag { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; min-width: 82px; height: 34px; padding: 7px 14px; border-radius: var(--radius-3xl); background: var(--color-sulfur); font: 500 16px/20px var(--font-body); color: var(--color-obsidian); }
  .rh__h1 { width: 480px; max-width: 100%; font-size: 70px; line-height: 65.8px; color: var(--color-obsidian); }
  .rh__line { display: block; white-space: nowrap; }
  .rh__p { margin: 0; width: 406px; max-width: 100%; min-height: 49.6px; font: 500 16px/24.8px var(--font-body); color: var(--color-obsidian); }
  .rh__btns { display: flex; flex-wrap: wrap; gap: var(--spacing-10); margin-top: var(--spacing-32); }
  .rh__btn--dark { width: 196px; padding: var(--spacing-12); background: var(--color-obsidian); color: var(--color-limestone); }
  .rh__btn--dark:hover { background: var(--color-ember); }
  .rh__btn--dotted { width: 259px; padding: var(--spacing-12); }

  @media (max-width: 1023px) {
    .rh { padding-inline: var(--spacing-16); }
    .rh__row { flex-direction: column-reverse; height: auto; }
    .rh__media { flex: none; height: min(90vw, 480px); }
    .rh__card { flex: none; padding: var(--spacing-32) var(--spacing-24); gap: var(--spacing-48); }
    .rh__h1 { width: auto; font-size: clamp(44px, 13vw, 70px); line-height: .94; }
    .rh__line { white-space: normal; }
    .rh__top, .rh__bottom { width: 100%; }
    .rh__btn--dark, .rh__btn--dotted { width: auto; flex: 1 1 200px; }
  }
</style>

<script>
  import { gsap, splitChars, EASE, reduced } from '../../scripts/motion.ts';
  import { CustomEase } from 'gsap/CustomEase';
  gsap.registerPlugin(CustomEase);
  const root = document.querySelector<HTMLElement>('[data-qa="r-hero"]');
  if (root && !reduced) {
    const chars = splitChars(root.querySelector<HTMLElement>('[data-rh-h1]')!);
    // Only readable appear entry of the reference page: opacity 0 -> 1, y -32 -> 0, 0.4s, cubic-bezier(.37,.97,.64,1).
    gsap.from(root.querySelectorAll('[data-rh-in]'), { opacity: 0, y: -32, duration: 0.4, ease: CustomEase.create('rAppear', '0.37,0.97,0.64,1'), stagger: 0.12, delay: 0.1 });
    gsap.from(chars, { yPercent: 40, opacity: 0, duration: 0.5, ease: EASE, stagger: 0.018, delay: 0.2 });
    gsap.from(root.querySelector('[data-rmedia]'), { opacity: 0, scale: 0.96, duration: 0.7, ease: EASE });
  }
</script>
