---
// Media block: tone fill + Unsplash photo in the duotone/halftone treatment of Products.astro + a looping house-style graphic.
// If the photo fails to load the block stays a solid tone block (DESIGN.md "Imagery").
import RGraphic from './RGraphic.astro';
const { tone = 'var(--color-plasma-violet)', img, kind, qa, ref, radius = true } = Astro.props;
---
<div class:list={['rmedia', { 'rmedia--round': radius }]} style={`--tone:${tone}`} data-qa={qa} data-ref={ref} data-rmedia>
  <div class="rmedia__layer" data-rmedia-parallax>
    {img?.url && (
      <img class="rmedia__photo" src={img.url} alt={img.alt} width="600" height="560" loading="lazy" decoding="async"
        data-credit={img.credit || undefined} onerror="this.style.display='none'" />
    )}
    <div class="rmedia__wash"></div>
    <div class="rmedia__halftone"></div>
  </div>
  <RGraphic kind={kind} />
</div>

<style>
  .rmedia { position: relative; overflow: hidden; background: var(--tone); isolation: isolate; min-width: 0; }
  .rmedia--round { border-radius: var(--radius-cards); }
  /* the layer is its own stacking context (will-change), so it carries the tone itself for the photo to multiply into */
  .rmedia__layer { position: absolute; inset: -7% 0; will-change: transform; background: var(--tone); }
  .rmedia__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.2) brightness(1.15); mix-blend-mode: multiply; opacity: .62; }
  .rmedia__wash { position: absolute; inset: 0; background: var(--tone); mix-blend-mode: screen; opacity: .28; }
  .rmedia__halftone { position: absolute; inset: 0; opacity: .5;
    background-image: radial-gradient(circle, var(--color-obsidian) 0 34%, transparent 38%), radial-gradient(circle, var(--color-obsidian) 0 20%, transparent 24%);
    background-size: 9px 9px, 9px 9px;
    -webkit-mask-image: radial-gradient(ellipse 55% 60% at 100% 0%, #000 0, transparent 100%), radial-gradient(ellipse 60% 55% at 0% 100%, rgba(0,0,0,.55) 0, transparent 100%);
    mask-image: radial-gradient(ellipse 55% 60% at 100% 0%, #000 0, transparent 100%), radial-gradient(ellipse 60% 55% at 0% 100%, rgba(0,0,0,.55) 0, transparent 100%); }
</style>

<script>
  import { gsap, reduced } from '../../scripts/motion.ts';
  if (!reduced) document.querySelectorAll<HTMLElement>('[data-rmedia-parallax]').forEach((layer) => {
    gsap.fromTo(layer, { yPercent: -5 }, { yPercent: 5, ease: 'none', scrollTrigger: { trigger: layer.parentElement!, start: 'top bottom', end: 'bottom top', scrub: true } });
  });
</script>
